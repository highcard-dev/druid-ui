{
  "name": "@druid-ui/build",
  "version": "4.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/highcard-dev/druid-ui.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "bin": {
    "druid-ui-build": "./bin/build.js",
    "druid-ui-gen-types": "./bin/gen-types.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "prebuild": "node ../../scripts/clean-package.mjs",
    "build": "esbuild src/index.ts src/vite.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outdir=dist && esbuild src/cmd/build.ts src/cmd/gen-types.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outdir=bin && tsc --emitDeclarationOnly"
  },
  "dependencies": {
    "@druid-ui/client": "4.0.0",
    "componentize-qjs": "0.5.0",
    "@bytecodealliance/jco-transpile": "0.20.0",
    "esbuild": "^0.25.11",
    "chokidar": "^4.0.3"
  },
  "peerDependencies": {
    "vite": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.7"
  }
}
