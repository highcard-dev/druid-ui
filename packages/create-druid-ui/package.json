{
  "name": "create-druid-ui",
  "version": "4.0.0-rc.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/highcard-dev/druid-ui.git"
  },
  "bin": {
    "create-druid-ui": "./bin/create.js"
  },
  "files": [
    "bin",
    "templates",
    "AGENTS.md"
  ],
  "scripts": {
    "prebuild": "node ../../scripts/clean-package.mjs",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=bin/create.js && node scripts/build-templates.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.11",
    "typescript": "~5.8.3"
  }
}
