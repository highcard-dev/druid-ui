{
  "name": "@druid-ui/config-editor",
  "version": "2.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/highcard-dev/druid-ui.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "npm run build:lib && npm run build:types",
    "build:lib": "esbuild src/index.ts --bundle --outfile=dist/index.js --format=esm --platform=neutral --external:@druid-ui/component --external:druid:ui/*",
    "build:types": "tsc --emitDeclarationOnly --outDir dist/types",
    "test": "vitest run src"
  },
  "dependencies": {
    "@druid-ui/component": "*"
  }
}
