{
  "name": "druid-ui-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "turbo build --filter='./packages/*'",
    "postbuild": "npm rebuild --ignore-scripts @druid-ui/build create-druid-ui",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish --tag next",
    "dev:openui": "npm run dev --workspace=druid-openui-starter",
    "build:examples": "node scripts/build-examples.mjs",
    "verify:packages": "node scripts/verify-packages.mjs",
    "watch": "turbo watch build --filter='./packages/*'",
    "test": "vitest run",
    "test:rust": "npm run test --workspace=druid-rust-example && node scripts/verify-rust-starters.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@tsconfig/node20": "^20.1.6",
    "@tsconfig/strictest": "^2.0.5",
    "@vitest/ui": "^4.1.10",
    "jsdom": "^26.1.0",
    "vitest": "^4.1.10",
    "prettier": "^3.6.2",
    "turbo": "^2.5.3",
    "typescript": "~5.8.3"
  }
}
