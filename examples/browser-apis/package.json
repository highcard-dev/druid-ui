    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@druid-ui/build": "4.0.0-rc.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.7"
  }
}
