$mode = "checks"
$report = "Ready"
root = Stack([Button("Run browser API checks", @CheckBrowser()), Button("Measure 180 animation frames", @Animate()), Text($report), Text("Canvas 2D"), Canvas("canvas", 320, 180), Text("WebGL"), Canvas("gl", 320, 180), Text("WebGPU"), Canvas("gpu", 320, 180), Text("Decoded video"), Canvas("decoded", 32, 32), Video("video")])
